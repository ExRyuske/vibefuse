// VibeFuse, the control panel of the MiniFuse 1. One window: the input on
// the left, the mixer on the right, settings behind a button in the header.
// Nothing animates, so the window only redraws when a value changes. The
// tray icon outlives the window. Texts are English; translations come from
// translations/<language>/LC_MESSAGES/vibefuse.po.

import { Palette } from "std-widgets.slint";

// Number parsing lives in Rust: it accepts "-6,5", "−6" and a "dB" suffix.
export global Numbers {
    // Returns a value below -1e8 for text that is not a number.
    pure callback parse(string) -> float;
}

// A row of the software mixer for the selected mix.
export struct SourceView {
    // Shown name: the user's or the channel's.
    name: string,
    channel: string,
    custom: bool,
    level: float,
    pan: float,
    pan-label: string,
    stereo: bool,
    // Both channels on one pan.
    mono: bool,
    muted: bool,
    meter-left: float,
    meter-right: float,
}

// A renamable channel: the shown name and the channel it stands for.
export struct Label {
    text: string,
    channel: string,
    custom: bool,
}

// Neutral greys that follow the system's light or dark appearance, and an
// accent color the user picks in the settings.
export global Theme {
    out property <bool> dark: Palette.color-scheme != ColorScheme.light;
    // Orange, pink, teal, violet, blue: in the order of `Accent::PRESETS`.
    // An index past them picks the user's own color.
    in property <int> accent-index;
    in property <color> custom-accent: #ff8a3d;
    // Text on the accent: dark on a light color.
    in property <color> on-accent: #ffffff;
    out property <[color]> accents: dark ? [#ff8a3d, #f0609e, #2bc4b4, #8b5cf6, #3b82f6] : [#ea6a10, #db2777, #0d9488, #7c3aed, #2563eb];
    out property <color> background: dark ? #1c1c1e : #f2f2f3;
    out property <color> card: dark ? #262628 : #ffffff;
    out property <color> border: dark ? #353538 : #dddde0;
    out property <color> control: dark ? #313134 : #ececee;
    out property <color> hover: dark ? #3c3c40 : #e2e2e5;
    out property <color> track: dark ? #18181a : #e4e4e7;
    out property <color> text: dark ? #ececee : #1d1d1f;
    out property <color> muted: dark ? #98989d : #6e6e73;
    out property <color> accent: accent-index < accents.length ? accents[accent-index] : custom-accent;
    // The handles: of the faders, the pan and the switches.
    out property <color> thumb: dark ? #45454a : #ffffff;
    out property <color> thumb-border: dark ? #55555b : #c7c7cc;
    out property <color> green: dark ? #30d158 : #28b44c;
    out property <color> amber: dark ? #ffb340 : #f59e0b;
    out property <color> red: dark ? #ff453a : #e5372c;
    // How much of its color an unlit meter section keeps.
    out property <float> unlit: dark ? 0.3 : 0.32;
}

component Card inherits Rectangle {
    background: Theme.card;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 12px;
}

component Heading inherits Text {
    color: Theme.text;
    font-size: 13px;
    font-weight: 600;
}

// Push button. `primary` fills it with the accent color, `flat` leaves only
// the text until the pointer is over it.
component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> flat;
    in property <bool> enabled: true;
    callback clicked;

    height: 28px;
    min-width: max(root.flat ? 0px : 64px, caption.preferred-width + (root.flat ? 16px : 24px));
    border-radius: 7px;
    border-width: root.primary || root.flat ? 0px : 1px;
    border-color: Theme.border;
    background: root.primary ? Theme.accent : touch.has-hover && root.enabled ? Theme.hover : root.flat ? transparent : Theme.control;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    caption := Text {
        text: root.text;
        color: root.primary ? Theme.on-accent : Theme.text;
        font-size: 12px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Latching button that lights up while engaged (INST, +48V, DIRECT).
component Toggle inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> on;
    in property <color> tint: Theme.accent;
    callback clicked;

    min-width: max(44px, caption.preferred-width + 24px);
    height: 28px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => {
        root.clicked();
    }
    border-radius: 7px;
    border-width: 1px;
    border-color: root.on ? root.tint : Theme.border;
    background: root.on ? root.tint : (touch.has-hover ? Theme.hover : Theme.control);

    caption := Text {
        text: root.text;
        color: !root.on ? Theme.text : root.tint == Theme.accent ? Theme.on-accent : #ffffff;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled;

    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => {
        root.toggled();
    }

    width: 36px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    background: root.on ? Theme.accent : Theme.track;

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        x: root.on ? root.width - self.width - 2px : 2px;
        y: 2px;
        border-width: 1px;
        border-color: Theme.thumb-border;
        background: Theme.thumb;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

// One bar of a peak meter, `bottom`..0 dBFS, in the sections OBS uses:
// green up to -20 dB, yellow up to -9 dB, red above. Unlit sections show
// dimly, so the scale is there in silence too.
component Bar inherits Rectangle {
    in property <float> level: -120;
    in property <string> label;
    // -60 dB unless the fader around it goes lower.
    in property <float> bottom: -60;
    property <float> fraction: clamp((root.level - root.bottom) / -root.bottom, 0, 1);
    // Where the yellow and the red sections start, from the bottom.
    property <float> warning: (-20 - root.bottom) / -root.bottom;
    property <float> error: (-9 - root.bottom) / -root.bottom;

    border-radius: 2px;
    clip: true;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: root.level.to-fixed(1);

    Rectangle {
        y: root.height * (1 - root.warning);
        height: root.height * root.warning;
        background: Theme.green.mix(Theme.track, Theme.unlit);
    }

    Rectangle {
        y: root.height * (1 - root.error);
        height: root.height * (root.error - root.warning);
        background: Theme.amber.mix(Theme.track, Theme.unlit);
    }

    Rectangle {
        y: 0;
        height: root.height * (1 - root.error);
        background: Theme.red.mix(Theme.track, Theme.unlit);
    }

    Rectangle {
        y: root.height * (1 - min(root.fraction, root.warning));
        height: root.height * min(root.fraction, root.warning);
        background: Theme.green;
    }

    Rectangle {
        y: root.height * (1 - min(root.fraction, root.error));
        height: root.height * max(0, min(root.fraction, root.error) - root.warning);
        background: Theme.amber;
    }

    Rectangle {
        y: root.height * (1 - root.fraction);
        height: root.height * max(0, root.fraction - root.error);
        background: Theme.red;
    }
}

// dB marks every 10 dB down a vertical scale from `maximum` at the top to
// `minimum` at the bottom, aligned to the right.
component Scale inherits Rectangle {
    in property <float> minimum: -60;
    in property <float> maximum: 0;
    property <float> top: floor(root.maximum / 10) * 10;

    for i in floor((root.top - root.minimum) / 10) + 1: Text {
        property <float> db: root.top - i * 10;
        y: root.height * (root.maximum - self.db) / (root.maximum - root.minimum) - self.height / 2;
        width: root.width;
        height: 12px;
        text: self.db > 0 ? "+" + self.db.to-fixed(0) : self.db.to-fixed(0);
        color: Theme.muted;
        font-size: 9px;
        horizontal-alignment: right;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// The peak meter of the input, without a fader, scaled like the faders.
component Meter inherits Rectangle {
    in property <float> level: -120;
    in property <string> label;

    width: 66px;

    Scale {
        x: 0;
        width: root.width / 2 - 16px;
    }

    Bar {
        x: (root.width - self.width) / 2;
        width: 8px;
        label: root.label;
        level: root.level;
    }
}

// The handle of the faders and the pan: a thin bar across the track in the
// color of the controls, with the accent along its middle.
component Cap inherits Rectangle {
    in property <bool> dimmed;
    in property <bool> focused;

    border-radius: min(root.width, root.height) / 2;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.accent : Theme.thumb-border;
    background: Theme.thumb;

    Rectangle {
        x: 2px;
        y: 2px;
        width: root.width - 4px;
        height: root.height - 4px;
        border-radius: min(self.width, self.height) / 2;
        background: root.dimmed ? Theme.muted : Theme.accent;
    }
}

// Vertical fader in dB whose track is the channel's meter, after the fader
// as in OBS. Without a meter it is a thin track like the pan's. A dB scale on
// the left. Drag, scroll, or double-click to reset.
component Fader inherits Rectangle {
    in property <float> value;
    in property <float> minimum: -60;
    in property <float> maximum: 0;
    in property <float> reset-value: 0;
    in property <string> label;
    // Muted channels show a grey cap.
    in property <bool> dimmed;
    // 0 none, 1 mono, 2 stereo
    in property <int> meters;
    in property <float> meter-left: -120;
    in property <float> meter-right: -120;
    callback changed(float);

    width: 66px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value.to-fixed(1);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: 0.5;
    accessible-action-set-value(v) => {
        root.set(v.to-float());
    }
    accessible-action-increment => {
        root.set(root.value + 0.5);
    }
    accessible-action-decrement => {
        root.set(root.value - 0.5);
    }
    // Half the cap: its middle reaches both ends of the track.
    property <length> inset: 4px;
    property <length> travel: root.height - 2 * root.inset;
    property <float> fraction: (root.value - root.minimum) / (root.maximum - root.minimum);
    property <length> knob-y: root.inset + root.travel * (1 - root.fraction);
    property <color> tint: root.dimmed ? Theme.muted : Theme.accent;
    property <length> centre: root.width / 2;

    function set(v: float) {
        root.changed(clamp(round(v * 10) / 10, root.minimum, root.maximum));
    }

    // Arrows move 0.5 dB, 0.1 dB with Shift; Page Up and Down 6 dB.
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.RightArrow {
                root.set(root.value + (event.modifiers.shift ? 0.1 : 0.5));
                return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.LeftArrow {
                root.set(root.value - (event.modifiers.shift ? 0.1 : 0.5));
                return accept;
            }
            if event.text == Key.PageUp {
                root.set(root.value + 6);
                return accept;
            }
            if event.text == Key.PageDown {
                root.set(root.value - 6);
                return accept;
            }
            reject
        }
    }

    property <length> track-width: root.meters == 2 ? 14px : root.meters == 1 ? 8px : 4px;

    Scale {
        x: 0;
        y: root.inset;
        width: root.centre - 16px;
        height: root.travel;
        minimum: root.minimum;
        maximum: root.maximum;
    }

    if root.meters == 0: Rectangle {
        x: root.centre - self.width / 2;
        y: root.inset;
        width: root.track-width;
        height: root.travel;
        border-radius: 2px;
        background: Theme.track;
    }

    if root.meters == 0: Rectangle {
        x: root.centre - self.width / 2;
        y: root.knob-y;
        width: root.track-width;
        height: root.inset + root.travel - self.y;
        border-radius: 2px;
        background: root.tint;
    }

    if root.meters >= 1: Bar {
        x: root.centre - root.track-width / 2;
        y: root.inset;
        width: root.meters == 2 ? (root.track-width - 2px) / 2 : root.track-width;
        height: root.travel;
        label: root.label + (root.meters == 2 ? " L" : "");
        bottom: root.minimum;
        level: root.meter-left;
    }

    if root.meters == 2: Bar {
        x: root.centre + 1px;
        y: root.inset;
        width: (root.track-width - 2px) / 2;
        height: root.travel;
        label: root.label + " R";
        bottom: root.minimum;
        level: root.meter-right;
    }

    Cap {
        x: root.centre - self.width / 2;
        y: root.knob-y - self.height / 2;
        width: root.track-width + 12px;
        height: 2 * root.inset;
        dimmed: root.dimmed;
        focused: focus.has-focus;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        property <float> start;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.start = root.value;
                focus.focus();
            }
        }
        moved => {
            if self.pressed {
                root.set(self.start + (self.pressed-y - self.mouse-y) / root.travel * (root.maximum - root.minimum));
            }
        }
        double-clicked => {
            root.set(root.reset-value);
        }
        scroll-event(event) => {
            if event.delta-y > 0 {
                root.set(root.value + 0.5);
                return accept;
            }
            if event.delta-y < 0 {
                root.set(root.value - 0.5);
                return accept;
            }
            reject
        }
    }
}

// Horizontal pan, 0 (left) .. 1 (right). Double-click centres.
component Pan inherits Rectangle {
    in property <float> value: 0.5;
    in property <string> label;
    in property <bool> dimmed;
    callback changed(float);

    height: 16px;
    width: 58px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value.to-fixed(2);
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    accessible-value-step: 0.01;
    accessible-action-set-value(v) => {
        root.set(v.to-float());
    }

    property <length> knob: 8px;
    property <length> travel: root.width - root.knob;
    property <length> centre: root.knob / 2 + root.travel / 2;
    property <length> at: root.knob / 2 + root.travel * root.value;

    function set(v: float) {
        root.changed(clamp(round(v * 100) / 100, 0, 1));
    }

    // Arrows move 5 steps of 100, one with Shift.
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.set(root.value + (event.modifiers.shift ? 0.01 : 0.05));
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.set(root.value - (event.modifiers.shift ? 0.01 : 0.05));
                return accept;
            }
            reject
        }
    }

    Rectangle {
        y: (root.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
    }

    // From the middle to the cap.
    Rectangle {
        x: min(root.centre, root.at);
        y: (root.height - self.height) / 2;
        width: abs(root.at - root.centre);
        height: 4px;
        background: root.dimmed ? Theme.muted : Theme.accent;
    }

    Rectangle {
        x: root.centre - 0.5px;
        y: 2px;
        width: 1px;
        height: root.height - 4px;
        background: Theme.muted;
    }

    Cap {
        x: root.at - self.width / 2;
        width: root.knob;
        height: root.height;
        dimmed: root.dimmed;
        focused: focus.has-focus;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        property <float> start;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.start = root.value;
                focus.focus();
            }
        }
        moved => {
            if self.pressed {
                root.set(self.start + (self.mouse-x - self.pressed-x) / root.travel);
            }
        }
        double-clicked => {
            root.set(0.5);
        }
    }
}

// Sums the two channels of a stereo source into one.
component MonoButton inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback clicked;

    width: 32px;
    height: 28px;
    border-radius: 7px;
    border-width: root.on ? 0px : 1px;
    border-color: Theme.border;
    background: root.on ? Theme.accent : (touch.has-hover ? Theme.hover : Theme.control);
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => {
        root.clicked();
    }

    Text {
        text: @tr("Mono");
        color: root.on ? Theme.on-accent : Theme.text;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Mutes a channel: a speaker, crossed out in red while muted. The button
// itself stays plain, so muted channels draw no attention.
component MuteButton inherits Rectangle {
    in property <bool> muted;
    in property <string> label;
    callback clicked;

    width: 32px;
    height: 28px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.hover : Theme.control;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.muted;
    accessible-action-default => {
        root.clicked();
    }

    property <color> ink: root.muted ? Theme.red : Theme.text;

    Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 16px;
        height: 14px;
        viewbox-width: 16;
        viewbox-height: 14;
        commands: "M 1 4.5 L 4 4.5 L 8 1 L 8 13 L 4 9.5 L 1 9.5 Z";
        fill: root.ink;
    }

    if !root.muted: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 16px;
        height: 14px;
        viewbox-width: 16;
        viewbox-height: 14;
        commands: "M 10.5 4.5 Q 12 7 10.5 9.5 M 12.5 2.5 Q 15.5 7 12.5 11.5";
        stroke: root.ink;
        stroke-width: 1.5px;
    }

    if root.muted: Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 16px;
        height: 14px;
        viewbox-width: 16;
        viewbox-height: 14;
        commands: "M 10.5 4.5 L 15 9.5 M 15 4.5 L 10.5 9.5";
        stroke: root.ink;
        stroke-width: 1.5px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Level in dB as a number; click it to type a new one, Enter applies,
// Esc cancels.
component ValueBox inherits Rectangle {
    in property <float> value;
    in property <float> minimum: -60;
    in property <float> maximum: 12;
    in property <string> label;
    callback changed(float);

    property <bool> editing;
    // No "-0.0"; the decimal separator follows the language.
    property <string> shown: (abs(root.value) < 0.05 ? 0 : root.value).to-fixed(1);

    width: 62px;
    height: 22px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.editing ? Theme.accent : (touch.has-hover ? Theme.border : transparent);
    background: root.editing ? Theme.control : transparent;
    accessible-role: spinbox;
    accessible-label: @tr("{}, dB", root.label);
    accessible-value: root.shown;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-action-set-value(text) => {
        root.commit(text);
    }

    function commit(text: string) {
        if Numbers.parse(text) > -100000000 {
            root.changed(clamp(round(Numbers.parse(text) * 10) / 10, root.minimum, root.maximum));
        }
        root.editing = false;
    }

    // Up and Down while typing: from the typed number, else the value.
    function step(delta: float) {
        root.changed(clamp(round(((Numbers.parse(input.text) > -100000000 ? Numbers.parse(input.text) : root.value) + delta) * 10) / 10, root.minimum, root.maximum));
        input.text = root.shown;
        input.select-all();
    }

    if !root.editing: Text {
        text: root.shown + " dB";
        color: Theme.text;
        font-size: 12px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 4px;
        width: root.width - 8px;
        visible: root.editing;
        enabled: root.editing;
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        accepted => {
            root.commit(self.text);
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.editing = false;
                return accept;
            }
            if event.text == Key.UpArrow {
                root.step(event.modifiers.shift ? 0.1 : 0.5);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.step(event.modifiers.shift ? -0.1 : -0.5);
                return accept;
            }
            reject
        }
        changed has-focus => {
            if !self.has-focus {
                root.editing = false;
            }
        }
    }

    touch := TouchArea {
        enabled: !root.editing;
        mouse-cursor: text;
        clicked => {
            input.text = root.shown;
            root.editing = true;
            input.focus();
            input.select-all();
        }
    }
}

// Channel name. Click it to rename: Enter keeps, Esc cancels, an empty name
// brings the channel's own back.
component NameBox inherits Rectangle {
    in property <Label> label;
    in property <TextHorizontalAlignment> text-alignment: center;
    in property <length> font-size: 12px;
    callback renamed(string);

    property <bool> editing;

    height: 22px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.editing ? Theme.accent : (touch.has-hover ? Theme.border : transparent);
    background: root.editing ? Theme.control : transparent;
    accessible-role: text-input;
    accessible-label: @tr("Name of {}", root.label.channel);
    accessible-value: root.label.text;
    accessible-action-set-value(text) => {
        root.renamed(text);
    }

    if !root.editing: Text {
        x: 3px;
        width: parent.width - 6px;
        text: root.label.text;
        color: Theme.text;
        font-size: root.font-size;
        font-weight: 600;
        horizontal-alignment: root.text-alignment;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 3px;
        width: parent.width - 6px;
        visible: root.editing;
        enabled: root.editing;
        color: Theme.text;
        font-size: root.font-size;
        horizontal-alignment: root.text-alignment;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        accepted => {
            root.editing = false;
            root.renamed(self.text);
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.editing = false;
                return accept;
            }
            reject
        }
        changed has-focus => {
            if !self.has-focus {
                root.editing = false;
            }
        }
    }

    touch := TouchArea {
        enabled: !root.editing;
        mouse-cursor: text;
        clicked => {
            input.text = root.label.text;
            root.editing = true;
            input.focus();
            input.select-all();
        }
    }
}

// One channel of a mixer, top to bottom: name, gain, the fader with its
// meter, pan, mono and mute. Every part has a fixed height, so strips
// without some of them still line up.
component Strip inherits VerticalLayout {
    in property <Label> label;
    property <string> name: root.label.text;
    // Output strips keep their fixed name.
    in property <bool> renamable: true;
    in property <float> level;
    in property <float> minimum: -60;
    in property <float> maximum: 12;
    in property <bool> muted;
    in property <bool> has-mute: true;
    in property <bool> has-pan;
    in property <float> pan: 0.5;
    in property <string> pan-label;
    // Stereo sources of the software mixer.
    in property <bool> has-mono;
    in property <bool> mono;
    // 0 none, 1 mono meter, 2 stereo meters
    in property <int> meters;
    in property <float> meter-left: -120;
    in property <float> meter-right: -120;
    callback level-changed(float);
    callback pan-changed(float);
    callback mute-clicked;
    callback mono-clicked;
    callback renamed(string);

    spacing: 4px;
    width: 70px;
    // A muted channel fades, all but its mute button.
    property <float> presence: root.muted ? 0.35 : 1;

    if root.renamable: NameBox {
        opacity: root.presence;
        label: root.label;
        renamed(text) => {
            root.renamed(text);
        }
    }

    if !root.renamable: Text {
        height: 22px;
        text: root.name;
        color: Theme.text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        ValueBox {
            opacity: root.presence;
            label: root.name;
            value: root.level;
            minimum: root.minimum;
            maximum: root.maximum;
            changed(v) => {
                root.level-changed(v);
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        Fader {
            opacity: root.presence;
            height: 208px;
            label: root.name;
            dimmed: root.muted;
            value: root.level;
            minimum: root.minimum;
            maximum: root.maximum;
            meters: root.meters;
            meter-left: root.meter-left;
            meter-right: root.meter-right;
            changed(v) => {
                root.level-changed(v);
            }
        }
    }

    VerticalLayout {
        height: 32px;
        spacing: 1px;
        alignment: center;

        if root.has-pan: HorizontalLayout {
            alignment: center;
            Pan {
                opacity: root.presence;
                value: root.pan;
                dimmed: root.muted;
                label: @tr("Pan {}", root.name);
                changed(v) => {
                    root.pan-changed(v);
                }
            }
        }

        if root.has-pan: Text {
            opacity: root.presence;
            text: root.pan-label;
            color: Theme.muted;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }

    HorizontalLayout {
        alignment: center;
        height: 28px;
        spacing: 2px;

        if root.has-mono: MonoButton {
            opacity: root.presence;
            label: @tr("Mono {}", root.name);
            on: root.mono;
            clicked => {
                root.mono-clicked();
            }
        }

        if root.has-mute: MuteButton {
            label: @tr("Mute {}", root.name);
            muted: root.muted;
            clicked => {
                root.mute-clicked();
            }
        }
    }
}

// Drop-down list of options.
component Choice inherits Rectangle {
    in property <[string]> options;
    in property <int> index: -1;
    in property <bool> enabled: true;
    in property <string> label;
    in property <length> preferred: 96px;
    callback selected(int);

    width: max(root.preferred, shown.preferred-width + 34px);
    height: 28px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover && root.enabled ? Theme.hover : Theme.control;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.index >= 0 ? root.options[root.index] : "";
    accessible-action-default => {
        if root.enabled {
            popup.show();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        shown := Text {
            horizontal-stretch: 1;
            text: root.index >= 0 ? root.options[root.index] : "—";
            color: Theme.text;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }

        // Drawn, not a "▾" glyph: not every system font has one.
        if root.enabled: VerticalLayout {
            alignment: center;
            Path {
                width: 8px;
                height: 5px;
                viewbox-width: 8;
                viewbox-height: 5;
                commands: "M 0.75 0.75 L 4 4 L 7.25 0.75";
                stroke: Theme.muted;
                stroke-width: 1.5px;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: parent.height + 4px;
        width: parent.width;

        Rectangle {
            background: Theme.card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000030;
        }

        VerticalLayout {
            padding: 4px;
            for name[index] in root.options: Rectangle {
                height: 26px;
                border-radius: 4px;
                accessible-role: list-item;
                accessible-label: name;
                accessible-action-default => {
                    root.selected(index);
                }
                background: option.has-hover ? Theme.hover : transparent;

                Text {
                    x: 8px;
                    text: name;
                    color: index == root.index ? Theme.accent : Theme.text;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                option := TouchArea {
                    clicked => {
                        root.selected(index);
                    }
                }
            }
        }
    }
}

// A round sample of an accent color in the settings.
component Swatch inherits Rectangle {
    in property <color> sample;
    in property <bool> selected;
    in property <string> label;
    callback clicked;

    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 2px;
    border-color: root.selected ? root.sample : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        x: 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.sample;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The user's own color: a dot that picks it and its six hex digits, sent
// with every change as typed.
component HexField inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <color> sample;
    in property <bool> selected;
    // The last thing typed was a color.
    in property <bool> valid: true;
    callback edited(string);
    callback picked;

    width: 108px;
    height: 28px;
    border-radius: 14px;
    border-width: root.selected || !root.valid ? 2px : 1px;
    border-color: !root.valid ? Theme.red : root.selected ? root.sample : input.has-focus ? Theme.accent : Theme.border;
    background: Theme.control;

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 10px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: root.sample;
                accessible-role: button;
                accessible-label: @tr("Custom");
                accessible-checkable: true;
                accessible-checked: root.selected;
                accessible-action-default => {
                    root.picked();
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked();
                    }
                }
            }
        }

        Text {
            text: "#";
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }

        input := TextInput {
            horizontal-stretch: 1;
            text: root.text;
            single-line: true;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            accessible-role: text-input;
            accessible-label: root.label;
            accessible-value: root.text;
            accessible-action-set-value(value) => {
                root.edited(value);
            }
            edited => {
                root.edited(self.text);
            }
        }
    }
}

// One segment of the mix selector.
component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 28px;
    // As wide as the bold caption, so selecting a tab moves none.
    min-width: bold.preferred-width + 28px;
    border-radius: 6px;
    background: root.selected ? Theme.accent : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    bold := Text {
        visible: false;
        text: root.text;
        font-size: 12px;
        font-weight: 600;
    }

    Text {
        text: root.text;
        color: root.selected ? Theme.on-accent : Theme.text;
        font-size: 12px;
        font-weight: root.selected ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A line of the settings: title and detail on the left, controls right.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;

    spacing: 16px;
    min-height: 36px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 13px;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: Theme.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    @children
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component App inherits Window {
    title: "VibeFuse";
    icon: @image-url("../assets/icon-256.png");
    background: Theme.background;
    default-font-size: 13px;
    preferred-width: 680px;

    // 0 searching, 1 storage mode, 2 unavailable, 3 connected
    in property <int> status;
    in property <string> status-text;
    in property <string> device-name: "MiniFuse 1";
    in property <string> device-detail;
    in property <string> message;
    // Live devices report meters; Linux applies changes in batches.
    in property <bool> live: true;
    in-out property <bool> settings-open;

    in property <bool> inst;
    in property <bool> phantom;
    in property <bool> direct;
    in property <Label> input-label: { text: "Input 1", channel: "Input 1", custom: false };

    // The device's own loopback mixer, shown when there is no software mixer.
    in property <bool> loopback;
    // Input 1, USB 1-2, USB 3-4
    in property <[Label]> loopback-labels: [
        { text: "Input 1", channel: "Input 1", custom: false },
        { text: "USB 1-2", channel: "USB 1-2", custom: false },
        { text: "USB 3-4", channel: "USB 3-4", custom: false },
    ];
    in property <float> in-level: -60;
    in property <float> in-pan: 0.5;
    in property <string> in-pan-label: "C";
    in property <bool> in-muted;
    in property <float> usb12-level;
    in property <bool> usb12-muted;
    in property <float> usb34-level;
    in property <bool> usb34-muted;
    in property <float> out-level;
    in property <bool> to-usb12;
    in property <bool> to-outputs;

    in property <float> meter-in: -60;
    in property <float> meter-left: -60;
    in property <float> meter-right: -60;

    // Software mixer: the Windows driver's, or the virtual devices of this
    // app on macOS and Linux.
    in property <bool> mixer;
    in property <[string]> mix-names;
    in property <int> mix-index;
    in property <[SourceView]> sources;
    in property <float> mix-level;
    in property <float> mix-meter-left: -120;
    in property <float> mix-meter-right: -120;

    in property <[string]> rates;
    in property <int> rate-index: -1;
    in property <bool> rate-settable;

    // Settings
    in property <[string]> languages;
    in property <int> language-index;
    // Names of the accent colors, in the order of `Theme.accents`.
    in property <[string]> accent-names;
    // The user's own accent color, six hex digits.
    in property <string> accent-hex;
    in property <bool> accent-hex-valid: true;
    in property <string> firmware-text;
    in property <bool> firmware-update;
    in property <bool> firmware-busy;
    in property <bool> asio;
    in property <[string]> asio-sizes;
    in property <int> asio-index: -1;
    in property <bool> asio-safe;
    // Virtual devices (macOS, Linux)
    in property <bool> devices-supported;
    in property <string> devices-text;
    // Text of the install button; empty hides it.
    in property <string> devices-install;
    in property <bool> devices-removable;
    in property <bool> devices-busy;
    in property <string> autostart-text;
    in property <bool> autostart;
    in property <string> version;

    callback toggle-inst();
    callback toggle-phantom();
    callback toggle-direct();
    callback toggle-loopback();
    // strip: 0 input, 1 USB 1-2, 2 USB 3-4, 3 mix output
    callback level-changed(int, float);
    callback pan-changed(float);
    callback mute-clicked(int);
    callback toggle-to-usb12();
    callback toggle-to-outputs();
    callback mix-selected(int);
    callback source-level(int, float);
    callback source-pan(int, float);
    callback source-mute(int);
    callback source-mono(int);
    callback mix-level-changed(float);
    // source (0 Input 1 … 4 Virtual 7/8), new name
    callback renamed(int, string);
    callback rate-selected(int);
    callback language-selected(int);
    // An index past the presets picks the user's own color.
    callback accent-selected(int);
    callback accent-hex-edited(string);
    callback import-settings();
    callback export-settings();
    callback leave-storage();
    callback check-firmware();
    callback open-firmware-page();
    callback asio-size-selected(int);
    callback toggle-asio-safe();
    callback install-devices();
    callback remove-devices();
    callback toggle-autostart();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header: the device, the sample rate, settings.
        HorizontalLayout {
            spacing: 8px;
            height: 36px;

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.device-name;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }

                if root.status == 3: Text {
                    text: root.device-detail;
                    color: root.firmware-update ? Theme.amber : Theme.muted;
                    font-size: 11px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.status == 3 && root.rate-index >= 0 && !root.settings-open: VerticalLayout {
                alignment: center;
                Choice {
                    label: @tr("Sample rate");
                    options: root.rates;
                    index: root.rate-index;
                    enabled: root.rate-settable;
                    selected(index) => {
                        root.rate-selected(index);
                    }
                }
            }

            if root.status == 3 && !root.settings-open: VerticalLayout {
                alignment: center;
                Button {
                    text: @tr("Import…");
                    flat: true;
                    clicked => {
                        root.import-settings();
                    }
                }
            }

            if root.status == 3 && !root.settings-open: VerticalLayout {
                alignment: center;
                Button {
                    text: @tr("Export…");
                    flat: true;
                    clicked => {
                        root.export-settings();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Button {
                    text: root.settings-open ? @tr("Done") : @tr("Settings");
                    primary: root.settings-open;
                    clicked => {
                        root.settings-open = !root.settings-open;
                    }
                }
            }
        }

        if root.settings-open: Card {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;

                SettingRow {
                    title: @tr("Language");

                    VerticalLayout {
                        alignment: center;
                        Choice {
                            label: @tr("Language");
                            preferred: 120px;
                            options: root.languages;
                            index: root.language-index;
                            selected(index) => {
                                root.language-selected(index);
                            }
                        }
                    }
                }

                Divider { }

                SettingRow {
                    title: @tr("Accent color");

                    HorizontalLayout {
                        spacing: 4px;
                        for name[index] in root.accent-names: VerticalLayout {
                            alignment: center;
                            Swatch {
                                sample: Theme.accents[index];
                                selected: index == Theme.accent-index;
                                label: name;
                                clicked => {
                                    root.accent-selected(index);
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            padding-left: 6px;
                            HexField {
                                label: @tr("Accent color, HEX");
                                text: root.accent-hex;
                                sample: Theme.custom-accent;
                                selected: Theme.accent-index >= Theme.accents.length;
                                valid: root.accent-hex-valid;
                                edited(text) => {
                                    root.accent-hex-edited(text);
                                }
                                picked => {
                                    root.accent-selected(Theme.accents.length);
                                }
                            }
                        }
                    }
                }

                Divider { }

                SettingRow {
                    title: @tr("Start at login");
                    detail: root.autostart-text;

                    VerticalLayout {
                        alignment: center;
                        Switch {
                            label: @tr("Start at login");
                            on: root.autostart;
                            toggled => {
                                root.toggle-autostart();
                            }
                        }
                    }
                }

                if root.devices-supported: Divider { }

                if root.devices-supported: SettingRow {
                    title: @tr("Virtual outputs");
                    detail: root.devices-text;

                    if root.devices-removable: VerticalLayout {
                        alignment: center;
                        Button {
                            text: @tr("Remove");
                            enabled: !root.devices-busy;
                            clicked => {
                                root.remove-devices();
                            }
                        }
                    }

                    if root.devices-install != "": VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.devices-install;
                            primary: true;
                            enabled: !root.devices-busy;
                            clicked => {
                                root.install-devices();
                            }
                        }
                    }
                }

                Divider { }

                SettingRow {
                    title: @tr("Firmware");
                    detail: root.firmware-text;

                    if root.firmware-update: VerticalLayout {
                        alignment: center;
                        Button {
                            text: @tr("Download…");
                            primary: true;
                            clicked => {
                                root.open-firmware-page();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.firmware-busy ? @tr("Checking…") : @tr("Check");
                            enabled: !root.firmware-busy;
                            clicked => {
                                root.check-firmware();
                            }
                        }
                    }
                }

                if root.asio: Divider { }

                if root.asio: SettingRow {
                    title: @tr("ASIO buffer size");
                    detail: @tr("Smaller means less latency, larger means fewer dropouts.");

                    VerticalLayout {
                        alignment: center;
                        Choice {
                            label: @tr("ASIO buffer size");
                            options: root.asio-sizes;
                            index: root.asio-index;
                            selected(index) => {
                                root.asio-size-selected(index);
                            }
                        }
                    }
                }

                if root.asio: SettingRow {
                    title: "Safe Mode";
                    detail: @tr("A spare buffer against dropouts. Arturia recommends keeping it on.");

                    VerticalLayout {
                        alignment: center;
                        Switch {
                            label: "Safe Mode";
                            on: root.asio-safe;
                            toggled => {
                                root.toggle-asio-safe();
                            }
                        }
                    }
                }

                Divider { }

                SettingRow {
                    title: "VibeFuse " + root.version;
                    detail: @tr("Free software under the GPL 3.0. Not affiliated with Arturia.");
                }
            }
        }

        if root.status == 3 && !root.settings-open: HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Card {
                width: 120px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    NameBox {
                        label: root.input-label;
                        font-size: 13px;
                        renamed(text) => {
                            root.renamed(0, text);
                        }
                    }

                    // The scale's end marks reach past the bar.
                    if root.live: HorizontalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        padding-top: 10px;
                        padding-bottom: 14px;
                        Meter {
                            min-height: 80px;
                            label: @tr("Level {}", root.input-label.text);
                            level: root.meter-in;
                        }
                    }

                    if !root.live: Rectangle {
                        vertical-stretch: 1;
                    }

                    Toggle {
                        text: "INST";
                        on: root.inst;
                        clicked => {
                            root.toggle-inst();
                        }
                    }

                    Toggle {
                        text: "+48V";
                        on: root.phantom;
                        tint: Theme.red;
                        clicked => {
                            root.toggle-phantom();
                        }
                    }

                    Toggle {
                        text: "DIRECT";
                        on: root.direct;
                        clicked => {
                            root.toggle-direct();
                        }
                    }
                }
            }

            if root.mixer: Card {
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: start;

                        // Segmented control.
                        Rectangle {
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.control;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                for name[index] in root.mix-names: Tab {
                                    text: name;
                                    selected: index == root.mix-index;
                                    clicked => {
                                        root.mix-selected(index);
                                    }
                                }
                            }
                        }
                    }

                    // Wider gaps keep each channel's buttons together.
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        for source[index] in root.sources: Strip {
                            label: { text: source.name, channel: source.channel, custom: source.custom };
                            level: source.level;
                            minimum: -60;
                            maximum: 0;
                            muted: source.muted;
                            has-pan: true;
                            pan: source.pan;
                            pan-label: source.pan-label;
                            has-mono: source.stereo;
                            mono: source.mono;
                            meters: root.live ? (source.stereo ? 2 : 1) : 0;
                            meter-left: source.meter-left;
                            meter-right: source.meter-right;
                            level-changed(v) => {
                                root.source-level(index, v);
                            }
                            pan-changed(v) => {
                                root.source-pan(index, v);
                            }
                            mute-clicked => {
                                root.source-mute(index);
                            }
                            mono-clicked => {
                                root.source-mono(index);
                            }
                            renamed(text) => {
                                root.renamed(index, text);
                            }
                        }

                        Rectangle {
                            width: 1px;
                            background: Theme.border;
                        }

                        Strip {
                            label: { text: @tr("Output"), channel: @tr("Output"), custom: false };
                            renamable: false;
                            level: root.mix-level;
                            minimum: -60;
                            maximum: 0;
                            has-mute: false;
                            meters: root.live ? 2 : 0;
                            meter-left: root.mix-meter-left;
                            meter-right: root.mix-meter-right;
                            level-changed(v) => {
                                root.mix-level-changed(v);
                            }
                        }
                    }
                }
            }

            if !root.mixer: Card {
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Heading {
                                text: "Loopback";
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        VerticalLayout {
                            alignment: center;
                            Switch {
                                label: "Loopback";
                                on: root.loopback;
                                toggled => {
                                    root.toggle-loopback();
                                }
                            }
                        }
                    }

                    if root.loopback: HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Strip {
                            label: root.loopback-labels[0];
                            level: root.in-level;
                            muted: root.in-muted;
                            has-pan: true;
                            pan: root.in-pan;
                            pan-label: root.in-pan-label;
                            level-changed(v) => {
                                root.level-changed(0, v);
                            }
                            pan-changed(v) => {
                                root.pan-changed(v);
                            }
                            mute-clicked => {
                                root.mute-clicked(0);
                            }
                            renamed(text) => {
                                root.renamed(0, text);
                            }
                        }

                        Strip {
                            label: root.loopback-labels[1];
                            level: root.usb12-level;
                            muted: root.usb12-muted;
                            level-changed(v) => {
                                root.level-changed(1, v);
                            }
                            mute-clicked => {
                                root.mute-clicked(1);
                            }
                            renamed(text) => {
                                root.renamed(1, text);
                            }
                        }

                        Strip {
                            label: root.loopback-labels[2];
                            level: root.usb34-level;
                            muted: root.usb34-muted;
                            level-changed(v) => {
                                root.level-changed(2, v);
                            }
                            mute-clicked => {
                                root.mute-clicked(2);
                            }
                            renamed(text) => {
                                root.renamed(2, text);
                            }
                        }

                        Rectangle {
                            width: 1px;
                            background: Theme.border;
                        }

                        Strip {
                            label: { text: @tr("Mix"), channel: @tr("Mix"), custom: false };
                            renamable: false;
                            level: root.out-level;
                            minimum: -64;
                            maximum: 0;
                            has-mute: false;
                            meters: root.live ? 2 : 0;
                            meter-left: root.meter-left;
                            meter-right: root.meter-right;
                            level-changed(v) => {
                                root.level-changed(3, v);
                            }
                        }
                    }

                    if root.loopback: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Toggle {
                            text: @tr("Mix → USB in 1/2");
                            on: root.to-usb12;
                            clicked => {
                                root.toggle-to-usb12();
                            }
                        }

                        Toggle {
                            text: @tr("Mix → outputs");
                            on: root.to-outputs;
                            clicked => {
                                root.toggle-to-outputs();
                            }
                        }
                    }
                }
            }
        }

        if root.status != 3 && !root.settings-open: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 12px;

            Text {
                text: root.status == 1 ? @tr("MiniFuse 1 is in storage mode") : (root.status == 2 ? root.status-text : @tr("Connect your MiniFuse 1"));
                color: Theme.text;
                font-size: 16px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if root.status == 1: HorizontalLayout {
                alignment: center;
                Button {
                    text: @tr("Switch to audio mode");
                    primary: true;
                    clicked => {
                        root.leave-storage();
                    }
                }
            }
        }

        if root.message != "": Text {
            text: root.message;
            color: Theme.amber;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// The icon in the menu bar (macOS), the notification area (Windows) or the
// tray (Linux). Closing the window leaves the app running here.
export component Tray inherits SystemTrayIcon {
    // macOS draws menu bar icons in one color that follows the bar.
    in property <bool> monochrome;
    in property <bool> window-open;
    callback open-window();
    callback hide-window();
    callback quit();

    icon: !root.monochrome ? @image-url("../assets/tray-color.png") : (Palette.color-scheme == ColorScheme.dark ? @image-url("../assets/tray-white.png") : @image-url("../assets/tray-black.png"));
    tooltip: "VibeFuse";
    clicked => {
        root.open-window();
    }

    Menu {
        MenuItem {
            title: root.window-open ? @tr("Hide VibeFuse") : @tr("Show VibeFuse");
            activated => {
                if root.window-open {
                    root.hide-window();
                } else {
                    root.open-window();
                }
            }
        }

        MenuSeparator { }

        MenuItem {
            title: @tr("Quit");
            activated => {
                root.quit();
            }
        }
    }
}
